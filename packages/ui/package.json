  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "generate:package": "node scripts/generate-package.mjs",
    "generate:theme": "node scripts/generate-theme.mjs --config tavo-ui.config.json --out src/theme/generated/default-theme.css",
    "build:lib": "npm run generate:package && npm run clean && npm run generate:theme && tsc -p tsconfig.build.json && node scripts/postbuild.mjs && node dist/cli/index.js --config tavo-ui.config.json --out dist/theme.css",
    "build:demo": "vite build",
    "build": "npm run build:lib && npm run build:demo",
    "benchmark": "npm run build:lib && node benchmarks/render/run.mjs",
    "benchmark:report": "npm run build:lib && BENCHMARK_ITERATIONS=1000 BENCHMARK_WARMUPS=100 BENCHMARK_BASELINE=benchmarks/render/baseline.json node benchmarks/render/run.mjs",
    "benchmark:baseline": "npm run build:lib && BENCHMARK_ITERATIONS=1000 BENCHMARK_WARMUPS=100 BENCHMARK_UPDATE_BASELINE=1 node benchmarks/render/run.mjs",
    "docs:tokens": "node scripts/generate-token-docs.mjs",
    "visual:regression": "node scripts/visual-regression.mjs",
    "dev": "npm run generate:theme && vite",
    "preview": "vite preview",
    "smoke:consumer": "node scripts/smoke-consumer.mjs",
    "pack:dry": "node scripts/pack-dry-run.mjs",
    "release:registry": "node scripts/check-publish-registry.mjs",
    "release:check": "npm run prepublishOnly",
    "release:dry": "npm run prepublishOnly",
    "test": "npm run build:lib && node --test tests/*.test.mjs",
    "typecheck": "npm run generate:package && tsc --noEmit",
    "prepublishOnly": "npm run release:registry && npm run typecheck && npm run test && npm run build && npm run smoke:consumer && npm run pack:dry"
  },
  "peerDependencies": {
    "@tavojs/core": "^1.0.0"
  },
  "dependencies": {
    "@tavojs/ui-cli": "^1.0.0",
    "@tavojs/ui-core": "^1.0.0"
  },
  "devDependencies": {
    "@tavojs/core": "^1.0.0",
    "@types/node": "^24.0.0",
    "sass": "^1.89.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
